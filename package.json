{
  "name": "home-server-frontend",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "local:serve-interactive": "run-s lint && ng serve --open --proxy-config proxy.conf.json",
    "ci:build": "run-s lint test-with-coverage build",
    "ci:release": "run-s test-no-watch-no-coverage build create-zip",
    "ng": "ng",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf coverage",
    "serve": "ng serve --proxy-config proxy.conf.json",
    "lint": "ng lint",
    "test-interactive": "ng test",
    "test-no-watch-no-coverage": "ng test --watch=false --browsers=ChromeHeadless",
    "test-with-coverage": "ng test --code-coverage --watch=false --browsers=ChromeHeadless",
    "build": "ng build --configuration production",
    "create-zip": "cd dist/browser && zip -r ../home-frontend.zip . && cd ../..",
    "reinstall": "npm run clean && npm install",
    "rebuild": "npm run clean && npm install && npm run build"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/localize": "^21.2.17",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@fortawesome/free-regular-svg-icons": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@popperjs/core": "^2.11.8",
    "@stomp/ng2-stompjs": "^8.0.0",
    "@types/c3": "^0.4.54",
    "@types/chroma-js": "^3.1.2",
    "@types/popper.js": "^1.11.0",
    "bootstrap": "^5.3.2",
    "buffer": "^6.0.3",
    "c3": "^0.4.24",
    "chroma-js": "^3.1.2",
    "jquery": "^3.7.1",
    "lodash-es": "^4.17.21",
    "ngx-spinner": "^19.0.0",
    "popper.js": "^1.16.1",
    "rxjs": "^7.8.1",
    "sockjs-client": "^1.6.1",
    "stompjs": "^2.3.3",
    "tslib": "^2.5.3",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.18",
    "@angular/compiler-cli": "^21.2.17",
    "@angular/language-service": "^21.2.17",
    "@types/jasmine": "~5.1.4",
    "@types/jasminewd2": "~2.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.2",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@typescript-eslint/types": "^8.61.1",
    "@typescript-eslint/utils": "^8.61.1",
    "dayjs": "^1.11.10",
    "eslint": "^8.57.0",
    "jasmine-core": "~5.1.1",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.69.5",
    "ts-mockito": "^2.6.1",
    "ts-node": "~10.9.2",
    "typescript": "~5.9.3"
  }
}
